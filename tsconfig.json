{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "chrome",
      "node"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src",
    "server",
    "tests"
  ]
}
